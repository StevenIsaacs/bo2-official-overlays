<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>benofficial2.Plugin</RootNamespace>
    <AssemblyName>benofficial2.Plugin</AssemblyName>
    <UseWPF>true</UseWPF>
    <LangVersion>7.3</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Deterministic>false</Deterministic>
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>portable</DebugType>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <!-- .NET Framework 4.8 reference assemblies (incl. WPF) for building on Linux -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="System.Resources.Extensions" Version="4.7.1" />
  </ItemGroup>

  <!-- SimHub reference DLLs, resolved from $(SIMHUB_INSTALL_PATH) (set by build-for-windows.sh) -->
  <ItemGroup>
    <Reference Include="AvalonDock"><HintPath>$(SIMHUB_INSTALL_PATH)AvalonDock.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="GameReaderCommon"><HintPath>$(SIMHUB_INSTALL_PATH)GameReaderCommon.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="log4net"><HintPath>$(SIMHUB_INSTALL_PATH)log4net.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="MahApps.Metro"><HintPath>$(SIMHUB_INSTALL_PATH)MahApps.Metro.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="MahApps.Metro.IconPacks.Core"><HintPath>$(SIMHUB_INSTALL_PATH)MahApps.Metro.IconPacks.Core.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="MahApps.Metro.IconPacks.FontAwesome"><HintPath>$(SIMHUB_INSTALL_PATH)MahApps.Metro.IconPacks.FontAwesome.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="MahApps.Metro.IconPacks.Material"><HintPath>$(SIMHUB_INSTALL_PATH)MahApps.Metro.IconPacks.Material.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="SimHub.Logging"><HintPath>$(SIMHUB_INSTALL_PATH)SimHub.Logging.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="SimHub.Plugins"><HintPath>$(SIMHUB_INSTALL_PATH)SimHub.Plugins.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="WoteverCommon"><HintPath>$(SIMHUB_INSTALL_PATH)WoteverCommon.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="WoteverLocalization"><HintPath>$(SIMHUB_INSTALL_PATH)WoteverLocalization.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Xceed.Wpf.Toolkit"><HintPath>$(SIMHUB_INSTALL_PATH)Xceed.Wpf.Toolkit.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <!-- .NET Framework assemblies not auto-referenced by the SDK for net48 -->
  <ItemGroup>
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Data.DataSetExtensions" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Net.WebSockets" />
    <Reference Include="System.Numerics" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

  <!-- Icon embedded by Properties/Resources.resx and copied to output -->
  <ItemGroup>
    <Content Include="sdkmenuicon.png" />
  </ItemGroup>

  <!-- Design-time XAML is not a runtime page -->
  <ItemGroup>
    <Page Remove="Properties/DesignTimeResources.xaml" />
  </ItemGroup>

</Project>
